{
  "name": "setscanner-allocation",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "triggers": {
    "crons": [
      "30 11,13 * * 1-5"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ALLOCATION",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "PWA_ORIGIN": "REPLACE_WITH_PWA_ORIGIN",
    "INDUSTRY_FEED_URL": "REPLACE_WITH_VERIFIED_HTTPS_FEED"
  },
  "observability": {
    "enabled": true
  }
}